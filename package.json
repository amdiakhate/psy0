{
  "name": "psy0-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:cubes:exhaustive": "VITE_CUBES_EXHAUSTIVE=1 vitest run src/exercises/cubes/domain/cubeGeometry.differential.test.ts --reporter=verbose",
    "validate:culture": "vitest run src/culture/validate-bank-script.test.ts --reporter=verbose",
    "verify": "npm run typecheck && npm run test",
    "build:server": "tsc -b tsconfig.server.json",
    "dev:server": "node --experimental-strip-types --watch server/src/index.ts",
    "start": "node server-dist/index.js",
    "hash-code": "node --experimental-strip-types server/src/hash-code.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "hono": "^4.13.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
