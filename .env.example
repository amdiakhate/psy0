# Variables à renseigner dans Coolify. Ne jamais committer les valeurs réelles.

# Mot de passe Postgres (choisis-en un long et aléatoire).
POSTGRES_PASSWORD=

# Empreinte du code d'accès et secret de session.
# Génère les deux d'un coup :  npm run hash-code -- "ton code d'accès"
# Le code en clair ne quitte jamais ton terminal ; seule l'empreinte est déployée.
ACCESS_CODE_HASH=
SESSION_SECRET=

# Uniquement si ton Postgres exige TLS (inutile sur le réseau interne Coolify).
# DATABASE_SSL=true
